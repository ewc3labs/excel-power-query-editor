{
  "include": [
    "README.md",
    "SUPPORT.md",
    "docs/**.md"
  ],
  "exclude": [
    "docs/Config_Reference.md"
  ],
  "values": {
    "tests": {
      "fromJson": {
        "file": "test-counts.json",
        "path": "total"
      }
    },
    "version": {
      "fromJson": {
        "file": "package.json",
        "path": "version"
      }
    },
    "commands": {
      "countJson": {
        "file": "package.json",
        "path": "contributes.commands"
      }
    },
    "settings": {
      "countJson": {
        "file": "package.json",
        "path": "contributes.configuration.properties"
      }
    },
    "vscodeMin": {
      "fromJson": {
        "file": "package.json",
        "path": "engines.vscode"
      }
    },
    "badgeVersion": {
      "template": {
        "text": "<img alt=\"Version\" src=\"https://img.shields.io/badge/Version-${version}-brightgreen.svg\">"
      }
    },
    "badgeTestsHtml": {
      "template": {
        "text": "<img alt=\"Tests\" src=\"https://img.shields.io/badge/tests-${tests}-brightgreen.svg\">"
      }
    },
    "testsNeedingExcel": {
      "countMatches": {
        "files": [
          "test/liveSync.integration.test.ts"
        ],
        "pattern": "^\\s*(test|it)\\("
      }
    }
  },
  "links": {
    "skipDirs": [
      "node_modules",
      ".git",
      "dist",
      "out",
      ".vscode-test",
      "archive",
      "coverage",
      "scratch"
    ]
  }
}
